<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniauiForEasytier.Views.NodesView">
    <UserControl.Styles>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17212F" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17212F" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#667085" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9DEE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.toolbar">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="BorderBrush" Value="#C7CED8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#0F9F8F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="18,14" RowDefinitions="38,16,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="page-title" Text="节点管理" />
                <TextBlock Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,3" FontSize="11" Text="查看网络成员、连接质量与节点详情" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                <Button Classes="toolbar outline" Content="刷新节点" />
                <Button Classes="toolbar accent" Content="添加节点" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="2" ColumnDefinitions="*,12,292">
            <Border Grid.Column="0" Classes="panel">
                <Grid RowDefinitions="42,38,*,31">
                    <Border Grid.Row="0" Padding="13,0" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                <TextBlock Classes="section-title" Text="网络节点" />
                                <Border Padding="6,2" Background="#EDF0F4" CornerRadius="8">
                                    <TextBlock FontSize="10" Foreground="#667085" Text="4 个" />
                                </Border>
                            </StackPanel>
                            <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" FontSize="11" Text="按延迟排序" />
                            <Button Grid.Column="2" Width="28" Height="28" Padding="5" Background="Transparent" ToolTip.Tip="更多列表操作">
                                <PathIcon Width="15" Height="15" Data="M6,10A2,2 0 1,0 6,14A2,2 0 0,0 6,10M12,10A2,2 0 1,0 12,14A2,2 0 0,0 12,10M18,10A2,2 0 1,0 18,14A2,2 0 0,0 18,10Z" />
                            </Button>
                        </Grid>
                    </Border>
                    <Border Grid.Row="1" Padding="10,5" Background="#F7F8FA" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="2.2*,1.35*,1.1*,80,80">
                            <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#667085" Text="节点名称" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#667085" Text="虚拟 IP" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#667085" Text="连接方式" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#667085" Text="延迟" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#667085" Text="状态" />
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Height="53" Padding="10,0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="2.2*,1.35*,1.1*,80,80">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                        <Ellipse Width="8" Height="8" Fill="#22C55E" />
                                        <StackPanel Spacing="2"><TextBlock FontSize="12" Foreground="#17212F" Text="office-gateway" /><TextBlock FontSize="10" Foreground="#98A2B3" Text="本地节点" /></StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#475467" Text="10.126.0.1" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#475467" Text="直连" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Foreground="#475467" Text="1 ms" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Foreground="#16A34A" Text="在线" />
                                </Grid>
                            </Border>
                            <Border Height="53" Padding="10,0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="2.2*,1.35*,1.1*,80,80">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                        <Ellipse Width="8" Height="8" Fill="#22C55E" />
                                        <StackPanel Spacing="2"><TextBlock FontSize="12" Foreground="#17212F" Text="laptop-alice" /><TextBlock FontSize="10" Foreground="#98A2B3" Text="Windows" /></StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#475467" Text="10.126.0.12" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#475467" Text="中继" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Foreground="#475467" Text="24 ms" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Foreground="#16A34A" Text="在线" />
                                </Grid>
                            </Border>
                            <Border Height="53" Padding="10,0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="2.2*,1.35*,1.1*,80,80">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                        <Ellipse Width="8" Height="8" Fill="#22C55E" />
                                        <StackPanel Spacing="2"><TextBlock FontSize="12" Foreground="#17212F" Text="nas-storage" /><TextBlock FontSize="10" Foreground="#98A2B3" Text="Linux" /></StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#475467" Text="10.126.0.20" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#475467" Text="中继" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Foreground="#475467" Text="31 ms" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Foreground="#16A34A" Text="在线" />
                                </Grid>
                            </Border>
                            <Border Height="53" Padding="10,0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                                <Grid ColumnDefinitions="2.2*,1.35*,1.1*,80,80">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                                        <Ellipse Width="8" Height="8" Fill="#D97706" />
                                        <StackPanel Spacing="2"><TextBlock FontSize="12" Foreground="#17212F" Text="phone-bob" /><TextBlock FontSize="10" Foreground="#98A2B3" Text="Android" /></StackPanel>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#475467" Text="10.126.0.35" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#475467" Text="中继" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Foreground="#475467" Text="--" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Foreground="#B45309" Text="离线" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                    <Border Grid.Row="3" Padding="10,0" Background="#F7F8FA" BorderBrush="#D9DEE6" BorderThickness="0,1,0,0">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Classes="muted" VerticalAlignment="Center" FontSize="10" Text="最后同步：从未同步" />
                            <TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" FontSize="10" Text="显示 4 / 4" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2" Classes="panel">
                <Grid RowDefinitions="42,*">
                    <Border Grid.Row="0" Padding="13,0" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1">
                        <TextBlock Classes="section-title" VerticalAlignment="Center" Text="节点详情" />
                    </Border>
                    <StackPanel Grid.Row="1" Margin="13" Spacing="14">
                        <StackPanel Spacing="5">
                            <TextBlock FontSize="15" FontWeight="SemiBold" Foreground="#17212F" Text="office-gateway" />
                            <StackPanel Orientation="Horizontal" Spacing="7"><Ellipse Width="7" Height="7" Fill="#22C55E" /><TextBlock FontSize="11" Foreground="#16A34A" Text="在线" /></StackPanel>
                        </StackPanel>
                        <Border Height="1" Background="#E5E7EB" />
                        <Grid ColumnDefinitions="94,*" RowDefinitions="26,26,26,26,26,26" RowSpacing="3">
                            <TextBlock Grid.Row="0" Classes="muted" FontSize="11" VerticalAlignment="Center" Text="虚拟 IP" /><TextBlock Grid.Row="0" Grid.Column="1" FontSize="11" VerticalAlignment="Center" Foreground="#344054" Text="10.126.0.1" />
                            <TextBlock Grid.Row="1" Classes="muted" FontSize="11" VerticalAlignment="Center" Text="操作系统" /><TextBlock Grid.Row="1" Grid.Column="1" FontSize="11" VerticalAlignment="Center" Foreground="#344054" Text="Windows" />
                            <TextBlock Grid.Row="2" Classes="muted" FontSize="11" VerticalAlignment="Center" Text="连接方式" /><TextBlock Grid.Row="2" Grid.Column="1" FontSize="11" VerticalAlignment="Center" Foreground="#344054" Text="直连" />
                            <TextBlock Grid.Row="3" Classes="muted" FontSize="11" VerticalAlignment="Center" Text="延迟" /><TextBlock Grid.Row="3" Grid.Column="1" FontSize="11" VerticalAlignment="Center" Foreground="#344054" Text="1 ms" />
                            <TextBlock Grid.Row="4" Classes="muted" FontSize="11" VerticalAlignment="Center" Text="上传速度" /><TextBlock Grid.Row="4" Grid.Column="1" FontSize="11" VerticalAlignment="Center" Foreground="#344054" Text="0 B/s" />
                            <TextBlock Grid.Row="5" Classes="muted" FontSize="11" VerticalAlignment="Center" Text="下载速度" /><TextBlock Grid.Row="5" Grid.Column="1" FontSize="11" VerticalAlignment="Center" Foreground="#344054" Text="0 B/s" />
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Button Classes="toolbar outline" Content="复制虚拟 IP" />
                            <Button Classes="toolbar outline" Content="移除节点" />
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniauiForEasytier.Views.NetworkView">
    <UserControl.Styles>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17212F" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17212F" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#667085" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#475467" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9DEE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.toolbar">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#0F9F8F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="BorderBrush" Value="#C7CED8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.profile-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.profile-item.selected">
            <Setter Property="Background" Value="#E7F5F2" />
            <Setter Property="BorderBrush" Value="#0F9F8F" />
        </Style>
        <Style Selector="Button.quick-toggle">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="TabControl TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="14,7" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="18,14" ColumnDefinitions="224,12,*">
        <!-- 二级边栏：网络列表 -->
        <Border Grid.Column="0" Classes="panel">
            <Grid RowDefinitions="42,*">
                <Border Grid.Row="0" Padding="13,0" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="section-title" VerticalAlignment="Center" Text="网络" />
                        <Button x:Name="NewNetworkButton" Grid.Column="1" Width="26" Height="26" Padding="4" Background="Transparent" ToolTip.Tip="新建网络">
                            <PathIcon Width="15" Height="15" Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
                        </Button>
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NetworkSidebarPanel" Margin="10,3" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 右侧详情：头部 + 标签页 -->
        <Grid Grid.Column="2" x:Name="DetailRoot" RowDefinitions="Auto,12,*" IsVisible="False">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel VerticalAlignment="Center" Spacing="3">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <TextBlock x:Name="DetailTitleText" Classes="page-title" Text="未选择网络" />
                        <Border Padding="8,4" Background="#FFF7E6" CornerRadius="4" VerticalAlignment="Bottom" Margin="0,0,0,3">
                            <TextBlock x:Name="DetailStatusText" FontSize="10" Foreground="#9A5B08" Text="已停止" />
                        </Border>
                    </StackPanel>
                    <TextBlock x:Name="DetailInstanceText" Classes="muted" FontSize="11" Text="实例：--" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <Button x:Name="StartNetworkButton" Classes="toolbar accent" Content="启动网络" />
                    <Button x:Name="DeleteNetworkButton" Classes="toolbar outline" Content="删除" />
                </StackPanel>
            </Grid>

            <TabControl Grid.Row="2" x:Name="DetailTabControl" Background="Transparent" BorderThickness="0">
                <TabItem Header="配置">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <Grid RowDefinitions="Auto,14,Auto,14,Auto,14,Auto">
                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="section-title" FontSize="15" Text="网络参数" />
                                    <TextBlock Classes="muted" FontSize="11" Text="以下参数仅作用于当前网络。" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                    <Border Padding="8,4" Background="#FFF7E6" CornerRadius="4">
                                        <TextBlock x:Name="ProfileStatusText" FontSize="10" Foreground="#9A5B08" Text="未选择网络" />
                                    </Border>
                                    <Button x:Name="SaveProfileButton" Classes="toolbar accent" Content="保存网络" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="2" Classes="panel" Background="#FBFCFD" Padding="15">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="180,*,180,*" ColumnSpacing="12" RowSpacing="11">
                                    <TextBlock Grid.ColumnSpan="4" Classes="section-title" Text="基础信息" />
                                    <TextBlock Grid.Row="1" Classes="field-label" VerticalAlignment="Center" Text="网络名称" />
                                    <TextBox x:Name="ProfileNameTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="30" PlaceholderText="例如：办公室网络" />
                                    <TextBlock Grid.Row="2" Classes="field-label" VerticalAlignment="Center" Text="实例名称" />
                                    <TextBox x:Name="InstanceNameTextBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="30" PlaceholderText="EasyTier FFI 唯一实例名" />
                                    <TextBlock Grid.Row="3" Classes="field-label" VerticalAlignment="Center" Text="虚拟网络名称" />
                                    <TextBox x:Name="NetworkNameTextBox" Grid.Row="3" Grid.Column="1" Height="30" PlaceholderText="填写网络标识" />
                                    <TextBlock Grid.Row="3" Grid.Column="2" Classes="field-label" VerticalAlignment="Center" Text="虚拟网段" />
                                    <TextBox x:Name="Ipv4TextBox" Grid.Row="3" Grid.Column="3" Height="30" PlaceholderText="例如：10.126.0.1/24" />
                                    <TextBlock Grid.Row="4" Classes="field-label" VerticalAlignment="Center" Text="本机节点名称" />
                                    <TextBox x:Name="HostnameTextBox" Grid.Row="4" Grid.Column="1" Height="30" PlaceholderText="可选" />
                                    <TextBlock Grid.Row="4" Grid.Column="2" Classes="field-label" VerticalAlignment="Center" Text="启动时自动连接" />
                                    <ToggleSwitch x:Name="AutoStartToggle" Grid.Row="4" Grid.Column="3" HorizontalAlignment="Left" OffContent="关闭" OnContent="开启" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="4" Classes="panel" Background="#FBFCFD" Padding="15">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="180,*,180,*" ColumnSpacing="12" RowSpacing="11">
                                    <Grid Grid.ColumnSpan="4" ColumnDefinitions="*,Auto,Auto">
                                        <TextBlock Classes="section-title" Text="连接参数" />
                                        <Button x:Name="PickServersButton" Grid.Column="1" Classes="toolbar outline" Margin="0,0,8,0" Content="从服务器列表选择" />
                                        <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center" FontSize="10" Text="可在 EasyTier 文档中获取参数说明" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Classes="field-label" VerticalAlignment="Center" Text="入口节点地址" />
                                    <TextBox x:Name="PeerTextBox" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3" Height="52" AcceptsReturn="True" TextWrapping="Wrap" PlaceholderText="每行一个入口节点，例如：tcp://example.com:11010" />
                                    <TextBlock Grid.Row="2" Classes="field-label" VerticalAlignment="Center" Text="认证密钥" />
                                    <TextBox x:Name="NetworkSecretTextBox" Grid.Row="2" Grid.Column="1" Height="30" PasswordChar="*" PlaceholderText="可选" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Classes="field-label" VerticalAlignment="Center" Text="连接模式" />
                                    <ComboBox Grid.Row="2" Grid.Column="3" Height="30" SelectedIndex="0">
                                        <ComboBoxItem Content="点对点" />
                                        <ComboBoxItem Content="通过公共入口" />
                                        <ComboBoxItem Content="仅本地" />
                                    </ComboBox>
                                    <Popup x:Name="ServerPickerPopup" IsLightDismissEnabled="True" Placement="Bottom" PlacementTarget="{Binding #PickServersButton}">
                                        <Border Background="White" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="6" Padding="12" MinWidth="300" MaxWidth="420" BoxShadow="0 8 24 #2417212F">
                                            <StackPanel Spacing="8">
                                                <TextBlock Classes="muted" FontSize="11" Text="勾选要加入的入口节点地址" />
                                                <StackPanel x:Name="ServerPickerPanel" Spacing="6" />
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>

                            <Border Grid.Row="6" Classes="panel" Background="#FBFCFD" Padding="15">
                                <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="180,*,180,*" ColumnSpacing="12" RowSpacing="11">
                                    <TextBlock Grid.ColumnSpan="4" Classes="section-title" Text="高级选项" />
                                    <TextBlock Grid.Row="1" Classes="field-label" VerticalAlignment="Center" Text="启用 IPv6" />
                                    <ToggleSwitch Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" OffContent="关闭" OnContent="开启" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="field-label" VerticalAlignment="Center" Text="允许局域网转发" />
                                    <ToggleSwitch Grid.Row="1" Grid.Column="3" HorizontalAlignment="Left" OffContent="关闭" OnContent="开启" />
                                    <TextBlock Grid.Row="2" Classes="field-label" VerticalAlignment="Center" Text="自定义启动参数" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="3" Height="30" PlaceholderText="可选，多个参数以空格分隔" />
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="节点">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock FontSize="13" Foreground="#667085" Text="该网络的节点列表将在接入 EasyTier 实时数据后显示。" />
                        <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#98A2B3" Text="当前为界面预留状态" />
                    </StackPanel>
                </TabItem>

                <TabItem Header="路由">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                        <TextBlock FontSize="13" Foreground="#667085" Text="该网络的路由信息将在接入 EasyTier 实时数据后显示。" />
                        <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#98A2B3" Text="当前为界面预留状态" />
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 未选择网络时的空状态 -->
        <Border Grid.Column="2" x:Name="DetailEmptyRoot" Classes="panel">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                <TextBlock FontSize="13" Foreground="#667085" Text="选择左侧网络查看详情，或点击“新建网络”创建" />
                <TextBlock HorizontalAlignment="Center" FontSize="11" Foreground="#98A2B3" Text="网络在详情页中运行和配置" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

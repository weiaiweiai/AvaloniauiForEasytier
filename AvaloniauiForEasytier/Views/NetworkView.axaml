<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniauiForEasytier.Views.NetworkView">
    <UserControl.Styles>
        <!-- 网络条目容器：选中态由外层描边和底色表示，内部按钮保持可点击 -->
        <Style Selector="Border.sidebar-item">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Margin" Value="0,0,0,3" />
        </Style>
        <Style Selector="Border.sidebar-item.selected">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AppAccentBrush}" />
        </Style>
        <Style Selector="Border.item-select">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="9,7" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.sidebar-item:pointerover > Grid > Border.item-select">
            <Setter Property="Background" Value="{DynamicResource AppRowHoverBrush}" />
        </Style>
        <Style Selector="Border.sidebar-item.selected:pointerover > Grid > Border.item-select">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.quick-toggle">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.quick-toggle:pointerover">
            <Setter Property="Background" Value="#E4E9EE" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="0" ColumnDefinitions="228,Auto,*">
        <!-- 二级边栏：网络列表 -->
        <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Classes="panel-header" Background="Transparent" BorderThickness="0,0,0,1" MinHeight="46" Padding="15,0">
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="group-title" VerticalAlignment="Center" Text="网络" />
                    <Button x:Name="NewNetworkButton" Grid.Column="1" Classes="icon" ToolTip.Tip="新建网络">
                        <PathIcon Width="15" Height="15" Foreground="{DynamicResource AppAccentBrush}" Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
                    </Button>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="NetworkSidebarPanel" Margin="10,8,10,10" />
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Width="1" Background="{DynamicResource AppOutlineBrush}" />

        <!-- 右侧详情：头部 + 标签页 -->
        <Grid Grid.Column="2" x:Name="DetailRoot" RowDefinitions="Auto,*" IsVisible="False">
            <Border Grid.Row="0" Padding="18,12" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel VerticalAlignment="Center" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="9">
                            <TextBlock x:Name="DetailTitleText" Classes="page-title" Text="未选择网络" />
                            <Border x:Name="DetailStatusBadge" Classes="badge" VerticalAlignment="Center" Margin="0,3,0,0">
                                <TextBlock x:Name="DetailStatusText" Text="已停止" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="DetailInstanceText" Classes="muted" FontSize="11" Text="实例：--" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Button x:Name="StartNetworkButton" Classes="toolbar accent" MinWidth="88" Content="启动网络" />
                        <Button x:Name="DeleteNetworkButton" Classes="toolbar danger" Content="删除" />
                    </StackPanel>
                </Grid>
            </Border>

            <TabControl Grid.Row="1" x:Name="DetailTabControl" Margin="18,6,18,0" Padding="0" Background="Transparent" BorderThickness="0">
                <TabItem Header="配置">
                    <ScrollViewer Margin="0,8,0,0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,0,16" Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Classes="group-title" Text="网络参数" />
                                    <TextBlock Classes="muted" FontSize="11" Text="以下参数仅作用于当前网络，保存后在下次启动生效。" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                    <TextBlock x:Name="ProfileStatusText" Classes="muted" FontSize="11" VerticalAlignment="Center" TextAlignment="Right" MaxWidth="240" TextWrapping="Wrap" Text="未选择网络" />
                                    <Button x:Name="SaveProfileButton" Classes="toolbar accent" Content="保存网络" />
                                </StackPanel>
                            </Grid>

                            <Border Classes="panel subtle" Padding="16,14">
                                <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="112,*,112,*" ColumnSpacing="12" RowSpacing="11">
                                    <TextBlock Grid.ColumnSpan="4" Classes="section-title" Margin="0,0,0,1" Text="基础信息" />
                                    <TextBlock Grid.Row="1" Classes="field-label" VerticalAlignment="Center" Text="网络名称" />
                                    <TextBox x:Name="ProfileNameTextBox" Grid.Row="1" Grid.Column="1" Classes="form" PlaceholderText="例如：办公室网络" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Classes="field-label" VerticalAlignment="Center" Text="实例名称" />
                                    <TextBox x:Name="InstanceNameTextBox" Grid.Row="1" Grid.Column="3" Classes="form" PlaceholderText="EasyTier 唯一实例名" />
                                    <TextBlock Grid.Row="2" Classes="field-label" VerticalAlignment="Center" Text="虚拟网络名称" />
                                    <TextBox x:Name="NetworkNameTextBox" Grid.Row="2" Grid.Column="1" Classes="form" PlaceholderText="填写网络标识" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Classes="field-label" VerticalAlignment="Center" Text="认证密钥" />
                                    <TextBox x:Name="NetworkSecretTextBox" Grid.Row="2" Grid.Column="3" Classes="form" PasswordChar="*" PlaceholderText="可选" />
                                    <TextBlock Grid.Row="3" Classes="field-label" VerticalAlignment="Center" Text="虚拟网段" />
                                    <StackPanel Grid.Row="3" Grid.Column="1" Spacing="3">
                                        <TextBox x:Name="Ipv4TextBox" Classes="form" PlaceholderText="例如：10.126.0.1/24" />
                                        <TextBlock Classes="hint" Text="留空则由网络自动分配地址" />
                                    </StackPanel>
                                    <TextBlock Grid.Row="3" Grid.Column="2" Classes="field-label" VerticalAlignment="Center" Text="本机节点名称" />
                                    <TextBox x:Name="HostnameTextBox" Grid.Row="3" Grid.Column="3" Classes="form" VerticalAlignment="Top" PlaceholderText="可选" />
                                    <TextBlock Grid.Row="4" Classes="field-label" VerticalAlignment="Center" Text="启动时自动连接" />
                                    <ToggleSwitch x:Name="AutoStartToggle" Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" OffContent="关闭" OnContent="开启" />
                                </Grid>
                            </Border>

                            <Border Classes="panel subtle" Padding="16,14">
                                <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="112,*" ColumnSpacing="12" RowSpacing="11">
                                    <Grid Grid.ColumnSpan="2" ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="section-title" Text="连接参数" />
                                        <TextBlock Grid.Column="1" Classes="hint" VerticalAlignment="Center" Text="信令服务器在“服务器列表”页维护" />
                                    </Grid>
                                    <TextBlock Grid.Row="1" Classes="field-label" VerticalAlignment="Top" Margin="0,7,0,0" Text="信令服务器" />
                                    <Border Grid.Row="1" Grid.Column="1" Background="{DynamicResource AppPanelBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="1" CornerRadius="5" Padding="11,9">
                                        <ScrollViewer MaxHeight="156" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                            <StackPanel x:Name="ServerListPanel" Spacing="5" MinHeight="20" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="节点">
                    <Grid Margin="0,10,0,14" RowDefinitions="Auto,8,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="section-title" Text="节点列表" />
                                <TextBlock x:Name="PeersUpdatedText" Classes="hint" Text="" />
                            </StackPanel>
                            <Button x:Name="RefreshPeersButton" Grid.Column="1" Classes="toolbar outline" VerticalAlignment="Center" Content="刷新" />
                        </Grid>
                        <Border Grid.Row="2" Classes="panel" ClipToBounds="True">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PeersRowsPanel" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="路由">
                    <Grid Margin="0,10,0,14" RowDefinitions="Auto,8,*">
                        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Classes="section-title" Text="路由列表" />
                                <TextBlock x:Name="RoutesUpdatedText" Classes="hint" Text="" />
                            </StackPanel>
                            <Button x:Name="RefreshRoutesButton" Grid.Column="1" Classes="toolbar outline" VerticalAlignment="Center" Content="刷新" />
                        </Grid>
                        <Border Grid.Row="2" Classes="panel" ClipToBounds="True">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="RoutesRowsPanel" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- 未选择网络时的空状态 -->
        <StackPanel Grid.Column="2" x:Name="DetailEmptyRoot" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="7">
            <PathIcon Width="34" Height="34" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="{DynamicResource AppOutlineStrongBrush}" Data="M12,2A5,5 0 0,0 7,7C7,8.64 7.79,10.09 9,11V13H7A5,5 0 0,0 2,18V22H22V18A5,5 0 0,0 17,13H15V11C16.21,10.09 17,8.64 17,7A5,5 0 0,0 12,2Z" />
            <TextBlock Classes="empty-title" Text="选择左侧网络查看详情" />
            <TextBlock Classes="empty-caption" Text="网络的启停、参数配置以及节点和路由都在详情页中完成" />
            <Button x:Name="EmptyStateNewNetworkButton" Classes="toolbar accent" HorizontalAlignment="Center" Margin="0,7,0,0" Content="新建网络" />
        </StackPanel>
    </Grid>
</UserControl>

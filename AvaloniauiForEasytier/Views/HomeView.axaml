<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniauiForEasytier.Views.HomeView">
    <UserControl.Styles>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17212F" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17212F" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#667085" />
        </Style>
        <Style Selector="TextBlock.column-header">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#667085" />
        </Style>
        <Style Selector="TextBlock.cell">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.cell-muted">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#98A2B3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9DEE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.toolbar">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#0F9F8F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="BorderBrush" Value="#C7CED8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.row-action">
            <Setter Property="Height" Value="26" />
            <Setter Property="MinWidth" Value="58" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="18,14" RowDefinitions="38,16,*,12,Auto">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="page-title" Text="主页" />
                <TextBlock Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,3" FontSize="11" Text="本机网络工作区" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                <Button x:Name="StartAllButton" Classes="toolbar accent" Content="启动全部" />
                <Button x:Name="StopAllButton" Classes="toolbar outline" Content="停止全部" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Classes="panel">
            <Grid RowDefinitions="40,Auto,*">
                <Border Grid.Row="0" Padding="13,0" Background="#F7F8FA" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="section-title" VerticalAlignment="Center" Text="网络列表" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                            <Ellipse x:Name="SummaryStatusIndicator" Width="8" Height="8" Fill="#98A2B3" />
                            <TextBlock x:Name="SummaryStatusText" Classes="muted" FontSize="11" Text="全部网络已停止" />
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Margin="13,6,13,0" Padding="0,0,0,7" BorderBrush="#EEF1F5" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="1.4*,1*,96,120,88">
                        <TextBlock Classes="column-header" VerticalAlignment="Center" Text="网络名称" />
                        <TextBlock Grid.Column="1" Classes="column-header" VerticalAlignment="Center" Text="虚拟网段" />
                        <TextBlock Grid.Column="2" Classes="column-header" VerticalAlignment="Center" Text="自动启动" />
                        <TextBlock Grid.Column="3" Classes="column-header" VerticalAlignment="Center" Text="状态" />
                        <TextBlock Grid.Column="4" Classes="column-header" VerticalAlignment="Center" Text="操作" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="NetworkRowsPanel" Margin="13,0,13,0" />
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="4" Classes="panel">
            <Grid RowDefinitions="40,Auto">
                <Border Grid.Row="0" Padding="13,0" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1">
                    <TextBlock Classes="section-title" VerticalAlignment="Center" Text="最近活动" />
                </Border>
                <StackPanel x:Name="RecentActivityPanel" Grid.Row="1" Margin="13,9,13,11" Spacing="6" MinHeight="28">
                    <TextBlock x:Name="RecentActivityEmptyText" Classes="muted" FontSize="11" Text="暂无网络输出" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniauiForEasytier.Views.ServersView">

    <Grid Margin="18,15,18,16" RowDefinitions="Auto,15,*,13,Auto">
        <!-- 页头：标题与新增入口 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="page-title" Text="服务器列表" />
                <TextBlock Classes="page-caption" Text="管理可复用的入口节点地址" />
            </StackPanel>
            <Button x:Name="AddServerButton" Grid.Column="1" Classes="toolbar accent" VerticalAlignment="Center" Content="添加服务器" />
        </Grid>

        <!-- 地址簿表格 -->
        <Border Grid.Row="2" Classes="panel">
            <Grid RowDefinitions="Auto,Auto,*">
                <Border Grid.Row="0" Classes="panel-header">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="section-title" VerticalAlignment="Center" Text="服务器地址簿" />
                        <TextBlock x:Name="ServersSummaryText" Grid.Column="1" Classes="muted" VerticalAlignment="Center" FontSize="11" Text="共 0 个" />
                    </Grid>
                </Border>
                <Border Grid.Row="1" Classes="table-header-row" Padding="14,8">
                    <Grid ColumnDefinitions="200,2*,150,124">
                        <TextBlock Classes="table-header" Text="名称" />
                        <TextBlock Grid.Column="1" Classes="table-header" Text="节点地址" />
                        <TextBlock Grid.Column="2" Classes="table-header" Text="添加时间" />
                        <TextBlock Grid.Column="3" Classes="table-header" Text="操作" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ServerRowsPanel" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- 底部编辑区：新增或修改单个服务器地址 -->
        <Border Grid.Row="4" Classes="panel subtle" Padding="16,14">
            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="88,*,88,2*,Auto,Auto" ColumnSpacing="12" RowSpacing="10">
                <TextBlock Grid.ColumnSpan="6" Classes="section-title" Text="服务器编辑" />
                <TextBlock Grid.Row="1" Classes="field-label" VerticalAlignment="Center" Text="服务器名称" />
                <TextBox x:Name="ServerNameTextBox" Grid.Row="1" Grid.Column="1" Classes="form" PlaceholderText="例如：公共服务器" />
                <TextBlock Grid.Row="1" Grid.Column="2" Classes="field-label" VerticalAlignment="Center" Text="节点地址" />
                <TextBox x:Name="ServerAddressTextBox" Grid.Row="1" Grid.Column="3" Classes="form" PlaceholderText="例如：tcp://public.easytier.cn:11010" />
                <Button x:Name="SaveServerButton" Grid.Row="1" Grid.Column="4" Classes="toolbar accent" Content="保存" />
                <Button x:Name="CancelServerButton" Grid.Row="1" Grid.Column="5" Classes="toolbar outline" Content="取消" />
                <TextBlock x:Name="ServerEditorStatusText" Grid.Row="2" Grid.ColumnSpan="6" Classes="muted" FontSize="11" Text="选择上方条目编辑，或点击“添加服务器”新增" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

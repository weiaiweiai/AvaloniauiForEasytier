<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniauiForEasytier.Views.RoutesView">
    <UserControl.Styles>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17212F" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#17212F" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Foreground" Value="#667085" />
        </Style>
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#D9DEE6" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="Button.toolbar">
            <Setter Property="Height" Value="31" />
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.outline">
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#344054" />
            <Setter Property="BorderBrush" Value="#C7CED8" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#0F9F8F" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="18,14" RowDefinitions="38,16,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="page-title" Text="路由管理" />
                <TextBlock Classes="muted" VerticalAlignment="Bottom" Margin="0,0,0,3" FontSize="11" Text="查看虚拟网络中的路由与转发路径" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7">
                <Button Classes="toolbar outline" Content="刷新路由" />
                <Button Classes="toolbar accent" Content="添加路由" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Classes="panel">
            <Grid RowDefinitions="42,38,*,31">
                <Border Grid.Row="0" Padding="13,0" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="8">
                            <TextBlock Classes="section-title" Text="路由表" />
                            <Border Padding="6,2" Background="#EDF0F4" CornerRadius="8"><TextBlock FontSize="10" Foreground="#667085" Text="3 条" /></Border>
                        </StackPanel>
                        <ComboBox Grid.Column="1" Width="115" Height="27" Margin="0,0,7,0" SelectedIndex="0" FontSize="11">
                            <ComboBoxItem Content="全部类型" />
                            <ComboBoxItem Content="直连" />
                            <ComboBoxItem Content="中继" />
                        </ComboBox>
                        <Button Grid.Column="2" Width="28" Height="28" Padding="5" Background="Transparent" ToolTip.Tip="更多路由操作">
                            <PathIcon Width="15" Height="15" Data="M6,10A2,2 0 1,0 6,14A2,2 0 0,0 6,10M12,10A2,2 0 1,0 12,14A2,2 0 0,0 12,10M18,10A2,2 0 1,0 18,14A2,2 0 0,0 18,10Z" />
                        </Button>
                    </Grid>
                </Border>
                <Border Grid.Row="1" Padding="11,0" Background="#F7F8FA" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="1.2*,1.2*,1.25*,1*,1*,90,72">
                        <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#667085" Text="目标网段" />
                        <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#667085" Text="下一跳" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#667085" Text="接口" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#667085" Text="协议" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#667085" Text="来源" />
                        <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#667085" Text="状态" />
                        <TextBlock Grid.Column="6" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="#667085" Text="操作" />
                    </Grid>
                </Border>
                <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Height="53" Padding="11,0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="1.2*,1.2*,1.25*,1*,1*,90,72">
                                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#344054" Text="10.126.0.0/16" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#344054" Text="--" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#344054" Text="easytier0" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Foreground="#344054" Text="直连" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Foreground="#667085" Text="系统" />
                                <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="11" Foreground="#16A34A" Text="活动" />
                                <Button Grid.Column="6" Width="55" Height="25" Padding="4" Background="Transparent" Foreground="#0F9F8F" FontSize="11" Content="查看" />
                            </Grid>
                        </Border>
                        <Border Height="53" Padding="11,0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="1.2*,1.2*,1.25*,1*,1*,90,72">
                                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#344054" Text="10.20.0.0/16" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#344054" Text="10.126.0.12" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#344054" Text="easytier0" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Foreground="#344054" Text="静态" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Foreground="#667085" Text="用户" />
                                <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="11" Foreground="#16A34A" Text="活动" />
                                <Button Grid.Column="6" Width="55" Height="25" Padding="4" Background="Transparent" Foreground="#0F9F8F" FontSize="11" Content="查看" />
                            </Grid>
                        </Border>
                        <Border Height="53" Padding="11,0" BorderBrush="#E5E7EB" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="1.2*,1.2*,1.25*,1*,1*,90,72">
                                <TextBlock VerticalAlignment="Center" FontSize="11" Foreground="#344054" Text="172.20.10.0/24" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#344054" Text="10.126.0.20" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="11" Foreground="#344054" Text="easytier0" />
                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="11" Foreground="#344054" Text="静态" />
                                <TextBlock Grid.Column="4" VerticalAlignment="Center" FontSize="11" Foreground="#667085" Text="用户" />
                                <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="11" Foreground="#B45309" Text="待检查" />
                                <Button Grid.Column="6" Width="55" Height="25" Padding="4" Background="Transparent" Foreground="#0F9F8F" FontSize="11" Content="查看" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <Border Grid.Row="3" Padding="11,0" Background="#F7F8FA" BorderBrush="#D9DEE6" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="*,Auto"><TextBlock Classes="muted" VerticalAlignment="Center" FontSize="10" Text="路由由 EasyTier Core 管理" /><TextBlock Grid.Column="1" Classes="muted" VerticalAlignment="Center" FontSize="10" Text="最后刷新：从未刷新" /></Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="AvaloniauiForEasytier.Views.LogsView">
    <UserControl.Styles>
        <!-- 日志行：整行可点击以在右侧查看详情 -->
        <Style Selector="Border.log-row">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.log-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource AppRowHoverBrush}" />
        </Style>
        <Style Selector="Border.log-row.selected">
            <Setter Property="Background" Value="{DynamicResource AppAccentSoftBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid Margin="18,15,18,16" RowDefinitions="Auto,15,*">
        <!-- 页头：标题与输出窗口命令 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <TextBlock Classes="page-title" Text="系统日志" />
                <TextBlock Classes="page-caption" Text="查看全部网络实例的实时输出" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                <Button x:Name="PauseScrollButton" Classes="toolbar outline" MinWidth="84" Content="暂停滚动" />
                <Button x:Name="ExportLogsButton" Classes="toolbar outline" Content="导出日志" />
                <Button x:Name="ClearLogsButton" Classes="toolbar outline" Content="清空" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="2" Classes="panel" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- 输出窗口工具条：运行状态、级别筛选和文本筛选 -->
                <Border Grid.Row="0" Classes="panel-header" MinHeight="46" Padding="11,0">
                    <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto">
                        <TextBlock Classes="section-title" VerticalAlignment="Center" Text="输出窗口" />
                        <Border Grid.Column="1" Classes="status-bar-divider" Height="16" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="7">
                            <Ellipse x:Name="LogServiceStatusIndicator" Width="7" Height="7" VerticalAlignment="Center" Fill="{DynamicResource AppPlaceholderBrush}" />
                            <TextBlock x:Name="LogServiceStatusText" Classes="muted" FontSize="11" Text="网络未运行" />
                        </StackPanel>
                        <ComboBox x:Name="LogLevelComboBox" Grid.Column="4" Classes="form" Width="106" Margin="0,0,7,0" VerticalAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="全部级别" />
                            <ComboBoxItem Content="信息" />
                            <ComboBoxItem Content="系统" />
                            <ComboBoxItem Content="错误" />
                        </ComboBox>
                        <TextBox x:Name="LogFilterTextBox" Grid.Column="5" Classes="form" Width="168" VerticalAlignment="Center" PlaceholderText="筛选文本" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,268">
                    <ScrollViewer x:Name="LogScrollViewer" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="LogOutputPanel" Margin="6,8" />
                    </ScrollViewer>

                    <Border Grid.Column="1" Width="1" Background="{DynamicResource AppOutlineBrush}" />

                    <!-- 事件详情：展示当前选中日志行的完整内容 -->
                    <Grid Grid.Column="2" RowDefinitions="Auto,*">
                        <Border Grid.Row="0" Classes="panel-header" Background="Transparent" MinHeight="38" Padding="14,0">
                            <TextBlock Classes="section-title" VerticalAlignment="Center" Text="事件详情" />
                        </Border>
                        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="14,12" Spacing="11">
                                <StackPanel Spacing="4">
                                    <TextBlock Classes="hint" Text="日志内容" />
                                    <TextBlock x:Name="DetailMessageText" Classes="mono" FontSize="11" Foreground="{DynamicResource AppTextStrongBrush}" TextWrapping="Wrap" Text="未选择日志行" />
                                </StackPanel>
                                <Border Height="1" Background="{DynamicResource AppOutlineSubtleBrush}" />
                                <Grid ColumnDefinitions="56,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                                    <TextBlock Classes="muted" FontSize="11" Text="级别" />
                                    <TextBlock x:Name="DetailLevelText" Grid.Column="1" FontSize="11" Foreground="{DynamicResource AppTextStrongBrush}" Text="--" />
                                    <TextBlock Grid.Row="1" Classes="muted" FontSize="11" Text="时间" />
                                    <TextBlock x:Name="DetailTimeText" Grid.Row="1" Grid.Column="1" Classes="mono" FontSize="11" Foreground="{DynamicResource AppTextStrongBrush}" Text="--" />
                                    <TextBlock Grid.Row="2" Classes="muted" FontSize="11" Text="来源" />
                                    <TextBlock x:Name="DetailSourceText" Grid.Row="2" Grid.Column="1" FontSize="11" Foreground="{DynamicResource AppTextStrongBrush}" TextWrapping="Wrap" Text="--" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

                <!-- 底部统计条：级别计数与滚动状态 -->
                <Border Grid.Row="2" Padding="11,0" MinHeight="28" Background="{DynamicResource AppPanelAltBrush}" BorderBrush="{DynamicResource AppOutlineBrush}" BorderThickness="0,1,0,0">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock x:Name="LogCountsText" Classes="status-bar-text" FontSize="10" Text="信息 0   系统 0   错误 0" />
                        <TextBlock x:Name="LogFilterSummaryText" Grid.Column="1" Classes="status-bar-text" FontSize="10" HorizontalAlignment="Center" Text="" />
                        <TextBlock x:Name="AutoScrollStateText" Grid.Column="2" Classes="status-bar-text" FontSize="10" Text="自动滚动：开启" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>

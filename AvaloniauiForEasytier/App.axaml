<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:suki="clr-namespace:SukiUI;assembly=SukiUI"
             x:Class="AvaloniauiForEasytier.App"
             RequestedThemeVariant="Light">
    <Application.Styles>
        <suki:SukiTheme ThemeColor="Green" />
        <!-- 桌面端统一设计令牌与控件样式，放在主题之后以便覆盖默认视觉。 -->
        <StyleInclude Source="avares://AvaloniauiForEasytier/Styles/DesktopTheme.axaml" />
    </Application.Styles>
</Application>
